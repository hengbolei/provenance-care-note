CARENOTE_ENVIRONMENT=production
CARENOTE_PUBLIC_BASE_URL=https://care-note.example.org
CARENOTE_TOKEN_SECRET=replace-with-a-secret-manager-value
CARENOTE_TOKEN_TTL_SECONDS=1800
CARENOTE_DATABASE_URL=postgresql://carenote:replace-me@postgres/carenote
CARENOTE_ENCRYPTION_KEY=replace-with-a-versioned-key-manager-value
CARENOTE_AUDIT_RETENTION_DAYS=2555
OPENAI_API_KEY=replace-with-a-project-scoped-key
CARENOTE_OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=replace-with-a-workspace-scoped-key
CARENOTE_ANTHROPIC_MODEL=claude-sonnet-5-5
CARENOTE_AGENT_GATEWAY=recorded
CARENOTE_AGENT_PROVIDER=openai
CARENOTE_AGENT_FALLBACK=anthropic
